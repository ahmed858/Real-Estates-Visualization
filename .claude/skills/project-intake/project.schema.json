{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ahmed858/Real-Estates-Visualization/project.schema.json",
  "title": "Unit Explorer project.json",
  "description": "Generated by `npm run generate:schema` from src/modules/schema. Do not edit by hand.\nAlso checked by `npm run validate` (not expressible here):\n- Scene ids are unique across the whole project.\n- Hotspot ids are unique within their scene.\n- A { scene } target names an existing scene other than the hotspot's own.\n- Every hotspot point lies inside its scene image (0 <= x <= width, 0 <= y <= height).\n- floors (typical floors) is only allowed on kind \"floor\", needs from <= to, and its hotspots use unitSuffix, never unit.\n- unitSuffix targets are only allowed on a typical floor.\n- rotation is required on and only allowed on type \"rotation-360\"; model likewise on type \"model-3d\".\n- Paths are relative to the project folder and never contain \"..\".",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "project": {
      "type": "object",
      "properties": {
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "name": {
          "type": "object",
          "properties": {
            "ar": {
              "type": "string",
              "minLength": 1
            },
            "en": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "ar",
            "en"
          ],
          "additionalProperties": false
        },
        "defaultLocale": {
          "type": "string",
          "enum": [
            "ar",
            "en"
          ]
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "contact": {
          "type": "object",
          "properties": {
            "whatsapp": {
              "type": "string",
              "pattern": "^\\+[1-9]\\d{7,14}$"
            }
          },
          "required": [
            "whatsapp"
          ],
          "additionalProperties": false
        },
        "branding": {
          "type": "object",
          "properties": {
            "logo": {
              "type": "string",
              "minLength": 1
            },
            "primaryColor": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "accentColor": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            }
          },
          "required": [
            "logo",
            "primaryColor",
            "accentColor"
          ],
          "additionalProperties": false
        },
        "location": {
          "type": "object",
          "properties": {
            "lat": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "lng": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            },
            "address": {
              "type": "object",
              "properties": {
                "ar": {
                  "type": "string",
                  "minLength": 1
                },
                "en": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "ar",
                "en"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "lat",
            "lng",
            "address"
          ],
          "additionalProperties": false
        },
        "published": {
          "type": "boolean"
        }
      },
      "required": [
        "slug",
        "name",
        "defaultLocale",
        "currency",
        "contact",
        "branding"
      ],
      "additionalProperties": false
    },
    "units": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "source": {
              "type": "string",
              "const": "xlsx"
            }
          },
          "required": [
            "source"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "source": {
              "type": "string",
              "const": "google-sheet"
            },
            "sheetId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{20,}$"
            },
            "gid": {
              "default": "0",
              "type": "string",
              "pattern": "^\\d+$"
            },
            "refreshSeconds": {
              "default": 60,
              "type": "integer",
              "minimum": 10,
              "maximum": 3600
            }
          },
          "required": [
            "source",
            "sheetId"
          ],
          "additionalProperties": false
        }
      ]
    },
    "root": {
      "$ref": "#/$defs/Scene"
    }
  },
  "required": [
    "schemaVersion",
    "project",
    "root"
  ],
  "additionalProperties": false,
  "$defs": {
    "Scene": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "facade",
            "masterplan",
            "phase",
            "block",
            "cluster",
            "building",
            "floor",
            "unit-plan",
            "other"
          ]
        },
        "type": {
          "default": "image-2d",
          "type": "string",
          "enum": [
            "image-2d",
            "rotation-360",
            "model-3d"
          ]
        },
        "title": {
          "type": "object",
          "properties": {
            "ar": {
              "type": "string",
              "minLength": 1
            },
            "en": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "ar",
            "en"
          ],
          "additionalProperties": false
        },
        "image": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "width": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "height": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "path",
            "width",
            "height"
          ],
          "additionalProperties": false
        },
        "rotation": {
          "type": "object",
          "properties": {
            "frames": {
              "type": "string",
              "minLength": 1
            },
            "count": {
              "type": "integer",
              "minimum": 2,
              "maximum": 360
            },
            "width": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "height": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "start": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "frames",
            "count",
            "width",
            "height"
          ],
          "additionalProperties": false
        },
        "model": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "path"
          ],
          "additionalProperties": false
        },
        "floors": {
          "type": "object",
          "properties": {
            "from": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "to": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "unitCode": {
              "type": "string"
            }
          },
          "required": [
            "from",
            "to",
            "unitCode"
          ],
          "additionalProperties": false
        },
        "hotspots": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "points": {
                "minItems": 3,
                "type": "array",
                "items": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    }
                  ],
                  "items": false,
                  "minItems": 2,
                  "maxItems": 2
                }
              },
              "frames": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "pattern": "^[1-9]\\d*$"
                },
                "additionalProperties": {
                  "minItems": 3,
                  "type": "array",
                  "items": {
                    "type": "array",
                    "prefixItems": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "number"
                      }
                    ],
                    "items": false,
                    "minItems": 2,
                    "maxItems": 2
                  }
                }
              },
              "mesh": {
                "type": "string",
                "minLength": 1
              },
              "target": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "scene": {
                        "type": "string",
                        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                      }
                    },
                    "required": [
                      "scene"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "unit": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "unit"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "unitSuffix": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "unitSuffix"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            },
            "required": [
              "id",
              "points",
              "target"
            ],
            "additionalProperties": false
          }
        },
        "children": {
          "default": [],
          "type": "array",
          "items": {
            "$ref": "#/$defs/Scene"
          }
        }
      },
      "required": [
        "id",
        "kind",
        "title",
        "image"
      ],
      "additionalProperties": false
    }
  }
}
