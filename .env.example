# Document each environment variable here as it is introduced.

# Internal drawing tool at /editor/<slug>. Off unless exactly "true".
# Set it only on your own machine (e.g. in .env.local) for `npm run dev`;
# leave it unset on Vercel so the editor is never public.
EDITOR_ENABLED=

# Show projects whose project.json says "published": false. Off unless exactly
# "true". Set it only on a preview deployment you share with the client; leave
# it unset on production so hidden projects answer 404.
PREVIEW_PROJECTS=

# A client's own domain opens only their project: comma-separated host=slug
# pairs, e.g. "units.client.com=client-towers,www.units.client.com=client-towers".
# On a listed host "/" shows the project, "/units" its table and "/<scene>" a
# scene; other projects and the editor answer 404. Bad entries are skipped with
# a warning in the logs. Add the domain to the Vercel project yourself first.
PROJECT_DOMAINS=

# Lead form ("Ask about this unit"): comma-separated slug=https-url pairs, e.g.
# "demo-villa=https://hooks.zapier.com/hooks/catch/123/abc/". Each visitor
# enquiry for that project is POSTed there as JSON (shape in docs/leads.md).
# A project without an entry shows no form. Webhook URLs are secrets: set them
# in Vercel's environment variables, never in project.json or the repo.
LEAD_WEBHOOKS=
