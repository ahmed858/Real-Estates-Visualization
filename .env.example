# Document each environment variable here as it is introduced.

# Internal drawing tool at /editor/<slug>. Off unless exactly "true".
# Set it only on your own machine (e.g. in .env.local) for `npm run dev`;
# leave it unset on Vercel so the editor is never public.
EDITOR_ENABLED=

# Show projects whose project.json says "published": false. Off unless exactly
# "true". Set it only on a preview deployment you share with the client; leave
# it unset on production so hidden projects answer 404.
PREVIEW_PROJECTS=
